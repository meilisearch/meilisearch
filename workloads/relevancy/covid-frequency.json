{
  "name": "covid-frequency.json",
  "type": "relevancy",
  "extraCliArgs": ["--http-payload-size-limit=200MB"],
  "assets": {
    "covid-queryset.json": {
      "local_location": "workloads/assets/trec-covid/covid-queryset.json",
      "remote_location": null
    },
    "covid-corpus.jsonl": {
      "local_location": "workloads/assets/trec-covid/covid-corpus.jsonl",
      "remote_location": null,
      "format": "NdJson"
    }
  },
  "precommands": [
    {
      "route": "indexes/relevancy/settings",
      "method": "PATCH",
      "body": {
        "inline": {
          "searchableAttributes": [
            "title",
            "text"
          ]
        }
      },
      "synchronous": "DontWait"
    },
    {
      "route": "indexes/relevancy/documents",
      "method": "POST",
      "body": {
        "asset": "covid-corpus.jsonl"
      },
      "synchronous": "WaitForTask"
    }
  ],
  "queryTemplate": {
    "querySetAsset": "covid-queryset.json",
    "template": {
      "q": "{{q}}",
      "matchingStrategy": "frequency"
    },
    "primaryKey": "_id"
  }
}
